---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Roduit Brice"
  description="Software engineer building backends, field service systems and multiplayer games."
>
  <section class="container intro">
    <p class="eyebrow">Software engineer</p>
    <h1>Roduit Brice</h1>
    <p class="lead">
      Backends, field service systems and multiplayer games. The full portfolio
      is on its way; meanwhile, my code lives on{" "}
      <a href="https://github.com/rodbrice">GitHub</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-24);
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .lead {
    max-inline-size: var(--measure);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }
</style>

---
// GitHub Pages serves a single 404.html for every missing URL, so this page is in the default language.
import { DEFAULT_LOCALE } from "../i18n/locales";
import { useTranslations } from "../i18n/ui";
import BaseLayout from "../layouts/BaseLayout.astro";

const t = useTranslations(DEFAULT_LOCALE);
---

<BaseLayout
  title={`${t("notFound.pageTitle")} · Roduit Brice`}
  description={t("notFound.description")}
  locale={DEFAULT_LOCALE}
>
  <section class="container not-found">
    <p class="code">404</p>
    <h1>{t("notFound.title")}</h1>
    <p>{t("notFound.body")}</p>
    <p>
      <a href="/">{t("notFound.back")}</a>
    </p>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-24);
  }

  .code {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.08em;
  }

  h1 {
    font-size: var(--text-2xl);
  }
</style>

---
import type { GetStaticPaths } from "astro";

import { getCollection } from "astro:content";

import ButtonLink from "../../components/ButtonLink.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { PROFILES } from "../../data/profile";
import { DEFAULT_LOCALE, LOCALES, localizePath } from "../../i18n/locales";
import type { Locale } from "../../i18n/locales";
import { useTranslations } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projectsFor } from "../../lib/projects";

export const getStaticPaths = (() =>
  LOCALES.map((locale) => ({
    params: { lang: locale === DEFAULT_LOCALE ? undefined : locale },
    props: { locale },
  }))) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const projects = projectsFor(await getCollection("projects"), locale);

// Structured data so search engines can tie the site to its author and profiles.
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Roduit Brice",
  url: new URL(localizePath("/", locale), Astro.site).href,
  jobTitle: t("meta.jobTitle"),
  knowsAbout: ["C#", ".NET", "React", "TypeScript"],
  sameAs: [PROFILES.github, PROFILES.linkedin],
};
---

<BaseLayout
  title={t("home.title")}
  description={t("home.description")}
  locale={locale}
  path="/"
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(person)}
  />
  <section class="container hero" aria-labelledby="hero-title">
    <h1 id="hero-title">Roduit Brice</h1>
    <p class="role">{t("home.role")}</p>
    <p class="lead">{t("home.lead")}</p>
    <ul class="actions">
      <li>
        <ButtonLink href="#projects" variant="primary">
          {t("home.projectsLink")}
        </ButtonLink>
      </li>
      <li>
        <ButtonLink href={PROFILES.linkedin} rel="me">
          {t("home.linkedinLink")}
        </ButtonLink>
      </li>
      <li>
        <ButtonLink href={PROFILES.github} rel="me">
          {t("home.githubLink")}
        </ButtonLink>
      </li>
    </ul>
  </section>

  <section
    id="projects"
    class="container projects"
    aria-labelledby="projects-title"
  >
    <h2 id="projects-title">{t("projects.title")}</h2>
    <ol class="project-list">
      {projects.map(({ slug, data }) => (
        <li>
          <ProjectCard
            project={data}
            href={
              data.caseStudy
                ? localizePath(`/projects/${slug}/`, locale)
                : undefined
            }
            stackLabel={t("project.stack")}
          />
        </li>
      ))}
    </ol>
  </section>

  <section id="about" class="container about" aria-labelledby="about-title">
    <h2 id="about-title">{t("about.title")}</h2>
    <div class="prose">
      <p>{t("about.body")}</p>
      <p>{t("about.availability")}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-24) var(--space-16);
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .role {
    color: var(--color-accent);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-medium);
  }

  .lead {
    max-inline-size: var(--measure);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .projects,
  .about {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-16) var(--space-24);
    border-block-start: 1px solid var(--color-border);
  }

  h2 {
    font-size: var(--text-2xl);
  }

  .project-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-6);
    padding: 0;
    list-style: none;

    & > li {
      display: grid;
    }
  }

  .prose {
    display: grid;
    gap: var(--space-4);
    max-inline-size: var(--measure);
  }
</style>

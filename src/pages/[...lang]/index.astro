---
import type { GetStaticPaths } from "astro";

import { getCollection } from "astro:content";

import DispatchSimulation from "../../components/DispatchSimulation.astro";
import NetworkSimulation from "../../components/NetworkSimulation.astro";
import ButtonLink from "../../components/ButtonLink.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import SectionIndex from "../../components/SectionIndex.astro";
import Timeline from "../../components/Timeline.astro";
import {
  AI_ASSISTED_DEVELOPMENT,
  SKILLS,
  TIMELINE,
} from "../../data/experience";
import { PROFILES } from "../../data/profile";
import { DEFAULT_LOCALE, LOCALES, localizePath } from "../../i18n/locales";
import type { Locale } from "../../i18n/locales";
import { useTranslations } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  cardId,
  projectPath,
  projectsFor,
  splitFeatured,
} from "../../lib/projects";

export const getStaticPaths = (() =>
  LOCALES.map((locale) => ({
    params: { lang: locale === DEFAULT_LOCALE ? undefined : locale },
    props: { locale },
  }))) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const projects = projectsFor(await getCollection("projects"), locale);
const groups = splitFeatured(projects);
const projectGroups = [
  { id: "featured", title: t("projects.featured"), list: groups.featured },
  { id: "other", title: t("projects.other"), list: groups.other },
];
const bySlug = new Map(projects.map((project) => [project.slug, project]));
/** A skill group's projects, by the part of their title before any dash. */
const skillProjects = (slugs: readonly string[]) =>
  slugs.map((slug) => {
    const project = bySlug.get(slug);
    if (!project) throw new Error(`Skill group names unknown project ${slug}`);
    return {
      name: project.data.title.split(" — ")[0] ?? project.data.title,
      href: localizePath(projectPath(slug, project.data), locale),
    };
  });
const steps = ["understand", "prototype", "build", "review"] as const;

// Structured data so search engines can tie the site to its author and profiles.
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Roduit Brice",
  url: new URL(localizePath("/", locale), Astro.site).href,
  jobTitle: t("meta.jobTitle"),
  knowsAbout: [
    "C#",
    ".NET",
    "React",
    "TypeScript",
    AI_ASSISTED_DEVELOPMENT[locale],
  ],
  sameAs: [PROFILES.github, PROFILES.linkedin],
};
---

<BaseLayout
  title={t("home.title")}
  description={t("home.description")}
  locale={locale}
  path="/"
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(person)}
  />
  <div class="container home-layout">
    <SectionIndex locale={locale} />
    <div class="home-content">
      <section class="hero" aria-labelledby="hero-title">
        <h1 id="hero-title">Roduit Brice</h1>
        <p class="role">{t("home.role")}</p>
        <p class="lead">{t("home.lead")}</p>
        <ul class="actions">
          <li>
            <ButtonLink href="#projects" variant="primary">
              {t("home.projectsLink")}
            </ButtonLink>
          </li>
          <li>
            <ButtonLink href="#contact">{t("home.contactLink")}</ButtonLink>
          </li>
          <li>
            <ButtonLink href={PROFILES.linkedin} rel="me">
              {t("home.linkedinLink")}
            </ButtonLink>
          </li>
          <li>
            <ButtonLink href={PROFILES.github} rel="me">
              {t("home.githubLink")}
            </ButtonLink>
          </li>
        </ul>
      </section>

      <section id="projects" class="projects" aria-labelledby="projects-title">
        <h2 data-reveal id="projects-title">
          <span class="section-number" aria-hidden="true">
            01
          </span>
          {t("projects.title")}
        </h2>
        {projectGroups.map(({ id, title, list }) => (
          <section
            class="project-group"
            aria-labelledby={`${id}-title`}
            data-group={id}
          >
            <h3 id={`${id}-title`}>{title}</h3>
            <ol class="project-list">
              {list.map(({ slug, data }) => (
                <li>
                  <ProjectCard
                    project={data}
                    id={cardId(slug)}
                    href={
                      data.caseStudy
                        ? localizePath(`/projects/${slug}/`, locale)
                        : undefined
                    }
                    locale={locale}
                  />
                </li>
              ))}
            </ol>
          </section>
        ))}
        <NetworkSimulation locale={locale} />
        <DispatchSimulation locale={locale} />
      </section>

      <section id="approach" class="approach" aria-labelledby="approach-title">
        <h2 data-reveal id="approach-title">
          <span class="section-number" aria-hidden="true">
            02
          </span>
          {t("approach.title")}
        </h2>
        <ol class="steps">
          {steps.map((step, index) => (
            <li>
              <span class="step-number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3>{t(`approach.${step}.title`)}</h3>
              <p>{t(`approach.${step}.body`)}</p>
            </li>
          ))}
        </ol>
      </section>

      <section id="about" class="about" aria-labelledby="about-title">
        <h2 data-reveal id="about-title">
          <span class="section-number" aria-hidden="true">
            03
          </span>
          {t("about.title")}
        </h2>
        <div class="prose">
          <p>{t("about.body")}</p>
          <p>{t("about.availability")}</p>
        </div>
      </section>

      <section
        id="experience"
        class="experience"
        aria-labelledby="experience-title"
      >
        <h2 data-reveal id="experience-title">
          <span class="section-number" aria-hidden="true">
            04
          </span>
          {t("experience.title")}
        </h2>
        <Timeline entries={TIMELINE} locale={locale} />
      </section>

      <section id="skills" class="skills" aria-labelledby="skills-title">
        <h2 data-reveal id="skills-title">
          <span class="section-number" aria-hidden="true">
            05
          </span>
          {t("skills.title")}
        </h2>
        <ul class="skill-groups">
          {SKILLS.map(({ label, skills, projects: slugs }) => (
            <li>
              <h3>{label[locale]}</h3>
              <div class="skill-detail">
                <ul class="technology-list" aria-label={label[locale]}>
                  {skills.map((skill) => (
                    <li>{skill[locale]}</li>
                  ))}
                </ul>
                <p class="used-in">
                  <span>
                    {t("skills.usedIn")}
                    {locale === "fr" ? "\u00a0:" : ":"}
                  </span>{" "}
                  <span class="used-in-links">
                    {skillProjects(slugs).map(({ name, href }, index) => (
                      <>
                        {index > 0 && ", "}
                        <a href={href}>{name}</a>
                      </>
                    ))}
                  </span>
                </p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section id="contact" class="contact" aria-labelledby="contact-title">
        <h2 data-reveal id="contact-title">
          <span class="section-number" aria-hidden="true">
            06
          </span>
          {t("contact.title")}
        </h2>
        <p class="prose">{t("contact.body")}</p>
        <ul class="actions">
          <li>
            <ButtonLink href={PROFILES.linkedin} rel="me" variant="primary">
              LinkedIn
            </ButtonLink>
          </li>
          <li>
            <ButtonLink href={PROFILES.github} rel="me">
              GitHub
            </ButtonLink>
          </li>
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .home-layout {
    display: grid;
    gap: var(--space-8);
  }

  .home-content {
    min-inline-size: 0;
  }

  @media (width >= 64rem) {
    .home-layout {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: var(--space-12);
    }
  }

  section {
    scroll-margin-block-start: var(--space-8);
  }

  .section-number {
    color: var(--color-accent);
    font-family: var(--font-technical);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-normal);
    letter-spacing: normal;
  }

  .hero {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-24) var(--space-16);
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .role {
    color: var(--color-accent);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-medium);
  }

  .lead {
    max-inline-size: var(--measure);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .projects,
  .approach,
  .about,
  .experience,
  .skills,
  .contact {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-16) var(--space-24);
    border-block-start: 1px solid var(--color-border);
  }

  h2 {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    font-size: var(--text-2xl);
  }

  .project-group {
    display: grid;
    gap: var(--space-4);

    & + & {
      margin-block-start: var(--space-6);
    }
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-6);
    padding: 0;
    list-style: none;

    & > li {
      display: grid;
      align-content: start;
      gap: var(--space-2);
      padding-block-start: var(--space-4);
      border-block-start: 1px solid var(--color-border);
    }

    & p {
      color: var(--color-text-muted);
    }
  }

  .step-number {
    color: var(--color-accent);
    font-family: var(--font-technical);
    font-size: var(--text-sm);
  }

  .skill-detail {
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }

  .used-in {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .project-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-6);
    padding: 0;
    list-style: none;

    & > li {
      display: grid;
    }
  }

  .skill-groups {
    display: grid;
    gap: var(--space-6);
    padding: 0;
    list-style: none;

    & > li {
      display: grid;
      align-content: start;
      gap: var(--space-3);
      padding-block-end: var(--space-6);
      border-block-end: 1px solid var(--color-border);

      @media (width >= 48rem) {
        grid-template-columns: minmax(8rem, 1fr) 2fr;
      }
    }
  }

  h3 {
    font-size: var(--text-lg);
  }

  .prose {
    display: grid;
    gap: var(--space-4);
    max-inline-size: var(--measure);
  }
</style>

---
import { localizePath } from "../i18n/locales";
import type { Locale } from "../i18n/locales";
import { useTranslations } from "../i18n/ui";
import LanguagePicker from "./LanguagePicker.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
  /** The current page's path without its locale prefix. */
  path: string;
}

const { locale, path } = Astro.props;
const t = useTranslations(locale);
const home = localizePath("/", locale);
const isHome = Astro.url.pathname === home;
---

<header class="site-header">
  <div class="container inner">
    <a class="wordmark" href={home} aria-current={isHome ? "page" : undefined}>
      Roduit Brice
    </a>
    <div class="actions">
      <LanguagePicker locale={locale} path={path} />
      <ThemeToggle label={t("theme.dark")} />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-block-end: 1px solid var(--color-border);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-block-size: 4.5rem;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .wordmark {
    color: var(--color-text);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tight);
    text-decoration: none;

    &:hover {
      color: var(--color-accent);
    }
  }
</style>

---
import { AREAS } from "../lib/sim/dispatch";
import { dispatchLabels } from "../data/dispatch-labels";
import type { Locale } from "../i18n/locales";
import { useTranslations } from "../i18n/ui";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const n = dispatchLabels[locale];
const t = useTranslations(locale);
---

<figure id="dispatch" data-dispatch>
  <h2 id="dispatch-title">{n.title}</h2>
  <div class="fallback" data-fallback>
    <svg
      viewBox="0 0 640 340"
      role="img"
      aria-labelledby="dispatch-title"
      aria-describedby="dispatch-description"
    >
      <path d="M120 70 V270 M520 70 V270 M120 170 H520" />
      {AREAS.map(({ x, y }, i) => (
        <g>
          <rect x={x - 70} y={y - 26} width="140" height="52" rx="4" />
          <text x={x} y={y + 5} text-anchor="middle">
            {n.area} {i + 1}
          </text>
        </g>
      ))}
      <text x="320" y="150" text-anchor="middle">
        {n.corridor}
      </text>
      {[1, 2, 3].map((id) => (
        <g>
          <rect x={200 + id * 48} y="184" width="32" height="28" rx="4" />
          <text x={216 + id * 48} y="203" text-anchor="middle">
            {id}
          </text>
        </g>
      ))}
    </svg>
  </div>
  <div data-interactive hidden>
    <div class="controls">
      <div class="latency">
        <label>
          {n.demand}
          <input
            type="range"
            min="4"
            max="40"
            step="1"
            value="16"
            data-demand
          />
        </label>
        <output data-demand-value>16 {n.perMinute}</output>
      </div>
      <label>
        {n.policy}
        <select data-policy>
          <option value="nearest">{n.nearest}</option>
          <option value="first">{n.first}</option>
        </select>
      </label>
      <button type="button" data-pause data-play={n.play} data-stop={n.pause}>
        {n.pause}
      </button>
    </div>
    {/* eslint-disable astro/jsx-a11y/no-interactive-element-to-noninteractive-role -- Read-only illustration operated by native controls. */}
    <canvas
      width="640"
      height="340"
      role="img"
      aria-labelledby="dispatch-title"
      aria-describedby="dispatch-description"
      data-labels={JSON.stringify(n)}
    ></canvas>
    {/* eslint-enable astro/jsx-a11y/no-interactive-element-to-noninteractive-role */}
    <p class="legend">
      <span class="intended">■ {n.occupied}</span> · □ {n.idle} · 1–3 AGV
    </p>
    <p class="readings">
      {n.queue}:{" "}
      <output data-queue aria-live="off">
        0
      </output>{" "}
      · {n.wait}:{" "}
      <output data-wait aria-live="off">
        0.0
      </output>{" "}
      s · {n.busy}:{" "}
      <output data-busy aria-live="off">
        0
      </output>{" "}
      %
    </p>
  </div>
  <p id="dispatch-description">{n.description}</p>
  <figcaption>
    <strong>{t("project.figure")} 2.</strong> {t("project.illustration")}
  </figcaption>
</figure>
<script>
  import "../scripts/dispatch";
</script>
<style>
  figure {
    display: grid;
    gap: var(--space-4);
    min-inline-size: 0;
    padding-block: var(--space-6);
  }
  h2 {
    font-size: var(--text-xl);
  }
  [data-interactive] {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: var(--space-4);
    border-radius: var(--radius-md);
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }
  label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .latency {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  input[type="range"] {
    max-inline-size: 100%;
  }
  input,
  select {
    accent-color: var(--color-accent);
  }
  button {
    padding: var(--space-2) var(--space-3);
    min-block-size: 2.75rem;
    border: 1px solid var(--color-text-muted);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
  }
  canvas {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
  .readings,
  .legend {
    font-family: var(--font-technical);
    font-size: var(--text-sm);
  }
  .intended {
    color: var(--color-accent);
  }
  #dispatch-description,
  figcaption {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .fallback {
    overflow-x: auto;
  }

  select {
    min-inline-size: 0;
    max-inline-size: 100%;
    background: var(--color-bg);
    color: var(--color-text);
    padding: var(--space-2);
  }
  label {
    flex-wrap: wrap;
  }
  svg {
    display: block;
    inline-size: 100%;
  }
  svg path {
    fill: none;
    stroke: var(--color-text-muted);
    stroke-width: 2;
  }
  svg rect {
    fill: var(--color-surface);
    stroke: var(--color-accent);
  }
  svg text {
    fill: var(--color-text);
    font: 14px var(--font-technical);
  }
</style>

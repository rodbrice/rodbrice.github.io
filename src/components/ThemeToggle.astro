---
// Hidden until the script runs: without JavaScript the site simply follows the system theme.

interface Props {
  /** Accessible name of the button; its pressed state says whether the dark theme is on. */
  label: string;
}

const { label } = Astro.props;
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-pressed="false"
  hidden
>
  <span class="visually-hidden">{label}</span>
  <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path>
  </svg>
  <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<script>
  import {
    oppositeTheme,
    parseTheme,
    resolveTheme,
    THEME_STORAGE_KEY,
  } from "../scripts/theme";
  import type { Theme } from "../scripts/theme";

  const root = document.documentElement;
  const prefersDark = window.matchMedia("(prefers-color-scheme: dark)");
  const buttons = document.querySelectorAll<HTMLButtonElement>(
    "[data-theme-toggle]",
  );

  const currentTheme = (): Theme =>
    resolveTheme(parseTheme(root.dataset.theme), prefersDark.matches);

  function render(): void {
    const isDark = String(currentTheme() === "dark");
    for (const button of buttons) {
      button.setAttribute("aria-pressed", isDark);
      button.hidden = false;
    }
  }

  function choose(theme: Theme): void {
    root.dataset.theme = theme;
    try {
      localStorage.setItem(THEME_STORAGE_KEY, theme);
    } catch {
      // Storage can be unavailable (private mode, blocked cookies); the choice then lasts for this page.
    }
    render();
  }

  for (const button of buttons) {
    button.addEventListener("click", () => {
      choose(oppositeTheme(currentTheme()));
    });
  }
  prefersDark.addEventListener("change", render);
  render();
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);

    &:hover {
      color: var(--color-text);
      border-color: var(--color-text-muted);
    }

    &[hidden] {
      display: none;
    }
  }

  .icon {
    inline-size: 1.25rem;
    block-size: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .theme-toggle[aria-pressed="true"] .icon-moon,
  .theme-toggle[aria-pressed="false"] .icon-sun {
    display: none;
  }
</style>

---
import { diagramLabels } from "../data/diagram-labels";
import type { Locale } from "../i18n/locales";

interface Props {
  project: string;
  locale: Locale;
  label: string;
}
const { project, locale, label } = Astro.props;
const d = diagramLabels[locale];
const marker = `arrow-${project}`;
interface Node {
  x: number;
  y: number;
  w: number;
  h: number;
  title: string;
  sub?: string;
  accent?: boolean;
}
let nodes: Node[] = [];
let paths: string[] = [];
let notes: { x: number; y: number; text: string }[] = [];
if (project === "field-operations") {
  nodes = [
    { x: 16, y: 32, w: 176, h: 72, title: "React + TypeScript", sub: d.fe },
    {
      x: 232,
      y: 32,
      w: 176,
      h: 72,
      title: "ASP.NET Core",
      sub: d.be,
      accent: true,
    },
    { x: 448, y: 32, w: 176, h: 72, title: "PostgreSQL", sub: d.data },
    { x: 232, y: 174, w: 176, h: 64, title: "Excel · PDF", sub: d.docs },
  ];
  paths = ["M192 68 H230", "M408 68 H446", "M320 142 V172"];
  notes = [
    { x: 320, y: 130, text: d.authwf },
    { x: 320, y: 276, text: d.tests },
    { x: 320, y: 302, text: "Docker · GitHub Actions" },
  ];
} else if (project === "property-management") {
  nodes = [
    { x: 16, y: 252, w: 184, h: 58, title: "PostgreSQL" },
    { x: 228, y: 252, w: 184, h: 58, title: d.files },
    { x: 440, y: 252, w: 184, h: 58, title: d.jobs },
  ];
  notes = [
    { x: 320, y: 226, text: "ASP.NET Core · PostgreSQL" },
    { x: 320, y: 342, text: d.auth },
    { x: 320, y: 374, text: d.archTests },
    { x: 320, y: 402, text: "Docker · CI/CD" },
  ];
} else if (project === "theone") {
  nodes = [
    { x: 16, y: 32, w: 224, h: 108, title: d.client, sub: d.predicts },
    {
      x: 400,
      y: 32,
      w: 224,
      h: 108,
      title: d.server,
      sub: d.validates,
      accent: true,
    },
    ...[d.combat, d.body, d.items, d.ai].map((title, i) => ({
      x: 16 + i * 156,
      y: 204,
      w: 140,
      h: 52,
      title,
    })),
  ];
  paths = ["M240 64 H398", "M400 108 H242"];
  notes = [
    { x: 320, y: 54, text: d.input },
    { x: 320, y: 132, text: d.state },
    { x: 320, y: 182, text: "C# · Unity 6 · FishNet" },
    { x: 320, y: 294, text: d.modules },
  ];
} else {
  throw new Error(`No approved diagram for ${project}`);
}
function wrap(text: string, max: number): string[] {
  const lines: string[] = [];
  for (const word of text.split(" ")) {
    const last = lines.length - 1;
    if (last < 0 || `${lines[last]} ${word}`.length > max) lines.push(word);
    else lines[last] += ` ${word}`;
  }
  return lines;
}
---

<svg
  viewBox={`0 0 640 ${project === "property-management" ? 424 : 328}`}
  role="img"
  aria-label={label}
>
  <defs>
    <marker
      id={marker}
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="7"
      markerHeight="7"
      orient="auto-start-reverse"
    >
      <path d="M0 0 L10 5 L0 10 z" class="arrowhead" />
    </marker>
  </defs>
  {project === "property-management" && (
    <>
      <rect x="64" y="16" width="512" height="188" rx="6" />
      <text x="84" y="42">
        {d.infra}
      </text>
      <rect x="144" y="54" width="352" height="118" rx="6" />
      <text x="164" y="80">
        {d.app}
      </text>
      <rect class="accent" x="224" y="92" width="192" height="56" rx="6" />
      <text x="320" y="126" text-anchor="middle" class="title">
        {d.inner}
      </text>
      <path d="M320 170 V150" marker-end={`url(#${marker})`} />
      <text x="320" y="194" text-anchor="middle">
        {d.inward}
      </text>
    </>
  )}
  {paths.map((path) => (
    <path d={path} marker-end={`url(#${marker})`} />
  ))}
  {nodes.map(({ x, y, w, h, title, sub, accent }) => {
    const titles = wrap(title, Math.floor((w - 20) / 8));
    const subtitles = sub ? wrap(sub, Math.floor((w - 20) / 7)) : [];
    const lines = [...titles, ...subtitles];
    const start = y + h / 2 - (lines.length - 1) * 10 + 5;
    return (
      <g>
        <rect class:list={{ accent }} x={x} y={y} width={w} height={h} rx="6" />
        {lines.map((line, i) => (
          <text
            class:list={{ title: i < titles.length }}
            x={x + w / 2}
            y={start + i * 20}
            text-anchor="middle"
          >
            {line}
          </text>
        ))}
      </g>
    );
  })}
  {notes.map(({ x, y, text }) => (
    <text x={x} y={y} text-anchor="middle">
      {text}
    </text>
  ))}
</svg>

<style>
  svg {
    display: block;
    inline-size: 100%;
    min-inline-size: 36rem;
    block-size: auto;
  }
  rect {
    fill: var(--color-surface);
    stroke: var(--color-text-muted);
  }
  rect.accent {
    fill: var(--color-accent-soft);
    stroke: var(--color-accent);
  }
  path {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
  }
  .arrowhead {
    fill: var(--color-accent);
    stroke: none;
  }
  text {
    fill: var(--color-text-muted);
    font: 13px var(--font-technical);
  }
  .title {
    fill: var(--color-text);
    font-weight: var(--font-weight-medium);
  }
</style>

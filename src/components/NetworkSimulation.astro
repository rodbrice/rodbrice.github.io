---
import Diagram from "./Diagram.astro";
import { netcodeLabels } from "../data/netcode-labels";
import type { Locale } from "../i18n/locales";
import { useTranslations } from "../i18n/ui";
interface Props {
  locale: Locale;
  number?: number;
}
const { locale, number = 1 } = Astro.props;
const n = netcodeLabels[locale];
const t = useTranslations(locale);
---

<figure id="network" data-network>
  <h2 id="network-title">{n.title}</h2>
  <div class="fallback" data-fallback>
    <Diagram
      project="rot-and-resolve"
      locale={locale}
      label={n.title}
      suffix="-network"
    />
  </div>
  <div data-interactive hidden>
    <div class="controls">
      <div class="latency">
        <label>
          {n.rtt} · RTT
          <input type="range" min="0" max="400" step="1" value="200" data-rtt />
        </label>
        <output data-latency>200 ms</output>
      </div>
      <label>
        <input type="checkbox" checked data-prediction /> {n.prediction}
      </label>
      <label>
        <input type="checkbox" checked data-reconciliation /> {n.reconciliation}
      </label>
      <button type="button" data-pause data-play={n.play} data-stop={n.pause}>
        {n.pause}
      </button>
    </div>
    {/* eslint-disable astro/jsx-a11y/no-interactive-element-to-noninteractive-role -- This canvas is a read-only illustration; native controls handle all interaction. */}
    <canvas
      width="640"
      height="360"
      role="img"
      aria-labelledby="network-title"
      aria-describedby="network-description"
      data-labels={JSON.stringify(n)}
    ></canvas>
    {/* eslint-enable astro/jsx-a11y/no-interactive-element-to-noninteractive-role */}
    <p class="legend">
      <span class="intended">━ {n.intended}</span> ·{" "}
      <span>┄ {n.perceived}</span> · ◇ {n.ghost}
    </p>
    <p class="readings">
      {n.pending}:{" "}
      <output data-pending aria-live="off">
        0
      </output>{" "}
      · {n.error}:{" "}
      <output data-error aria-live="off">
        0
      </output>{" "}
      px
    </p>
  </div>
  <p id="network-description">{n.description}</p>
  <figcaption>
    <strong>
      {t("project.figure")} {number}.
    </strong>{" "}
    {t("project.illustration")}
  </figcaption>
</figure>
<script>
  import "../scripts/netcode";
</script>
<style>
  figure {
    display: grid;
    gap: var(--space-4);
    min-inline-size: 0;
    padding-block: var(--space-6);
  }
  h2 {
    font-size: var(--text-xl);
  }
  [data-interactive] {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: var(--space-4);
    border-radius: var(--radius-md);
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }
  label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .latency {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  input[type="range"] {
    max-inline-size: 100%;
  }
  input {
    accent-color: var(--color-accent);
  }
  button {
    padding: var(--space-2) var(--space-3);
    min-block-size: 2.75rem;
    border: 1px solid var(--color-text-muted);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
  }
  canvas {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
  .readings,
  .legend {
    font-family: var(--font-technical);
    font-size: var(--text-sm);
  }
  .intended {
    color: var(--color-accent);
  }
  #network-description,
  figcaption {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .fallback {
    overflow-x: auto;
  }
</style>

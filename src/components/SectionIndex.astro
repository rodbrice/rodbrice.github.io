---
import type { Locale } from "../i18n/locales";
import { useTranslations, type UiKey } from "../i18n/ui";

interface Props {
  locale: Locale;
  sections?: readonly { id: string; label: string }[];
}
const t = useTranslations(Astro.props.locale);
const homeSections = [
  "projects",
  "about",
  "experience",
  "skills",
  "contact",
] as const;
const sections =
  Astro.props.sections ??
  homeSections.map((id) => ({ id, label: t(`${id}.title` satisfies UiKey) }));
---

<nav class="section-index" aria-label={t("nav.sections")}>
  <p>{t("nav.sections")}</p>
  <ol>
    {sections.map(({ id, label }, index) => (
      <li>
        <a href={`#${id}`}>
          <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          {label}
        </a>
      </li>
    ))}
  </ol>
</nav>

<script>
  import { initSectionIndex } from "../scripts/section-index";
  initSectionIndex();
</script>

<style>
  .section-index {
    align-self: start;
    padding-block: var(--space-8) 0;
    font-size: var(--text-sm);
  }

  p {
    margin-block-end: var(--space-3);
    color: var(--color-text-muted);
    font-family: var(--font-technical);
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding: 0;
    list-style: none;
  }

  a {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-block: var(--space-2);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  span {
    font-family: var(--font-technical);
  }

  a[aria-current="location"] {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: var(--space-1);
  }

  @media (width >= 64rem) {
    .section-index {
      position: sticky;
      inset-block-start: var(--space-8);
      padding-block-start: var(--space-24);
    }

    ol {
      display: grid;
      gap: var(--space-2);
    }
  }
</style>

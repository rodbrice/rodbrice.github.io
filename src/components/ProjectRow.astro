---
import type { CollectionEntry } from "astro:content";

import StatusMarker from "./StatusMarker.astro";
import type { Locale } from "../i18n/locales";
import { useTranslations } from "../i18n/ui";
import { primaryAction, projectVisibility } from "../lib/projects";

interface Props {
  project: CollectionEntry<"projects">["data"];
  /** Link to the case study, for projects that have one. */
  href?: string | undefined;
  /** Anchor for links to this row, e.g. from the skills that it shows. */
  id?: string | undefined;
  /** The title's view transition name, shared with the case study's heading. */
  titleTransition?: string | undefined;
  locale: Locale;
}

/**
 * A secondary project as one plain row: what it is, its title (linked to the
 * case study or the public source when there is one), the problem, then its
 * status and technologies. No contribution line and no figure: the featured
 * cards carry the detail.
 */
const { project, href, id, titleTransition, locale } = Astro.props;
const t = useTranslations(locale);
const action = primaryAction(project);
const visibility = projectVisibility(project);
const statusParts = [
  visibility === undefined ? undefined : t(`project.${visibility}`),
  t(`status.${project.status}`),
].filter((part) => part !== undefined);
---

<article class="row" id={id}>
  <p class="kind">{project.kind}</p>
  <h4 data-title-transition={titleTransition}>
    {action.kind === "caseStudy" && href !== undefined ? (
      <a href={href}>
        {project.title}
        <span aria-hidden="true">→</span>
      </a>
    ) : action.kind === "source" ? (
      <a href={action.href} rel="external">
        {project.title}
        <span aria-hidden="true">↗</span>
      </a>
    ) : (
      project.title
    )}
  </h4>
  <p class="problem">{project.problem}</p>
  <div class="meta">
    <StatusMarker status={project.status} label={t("project.status")}>
      {statusParts.join(" · ")}
    </StatusMarker>
    <ul class="technology-list" aria-label={t("project.stack")}>
      {project.stack.map((technology) => (
        <li>{technology}</li>
      ))}
    </ul>
  </div>
</article>

<style>
  .row {
    position: relative;
    display: grid;
    gap: var(--space-1) var(--space-6);
    padding-block: var(--space-4);
    border-block-end: 1px solid var(--color-border);
    scroll-margin-block-start: var(--space-8);

    @media (width >= 48rem) {
      grid-template-columns: minmax(8rem, 1fr) 2fr;

      & > :not(.kind) {
        grid-column: 2;
      }

      & > .kind {
        grid-row: 1 / span 3;
      }
    }
  }

  .kind {
    color: var(--color-accent);
    font-family: var(--font-technical);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
  }

  h4 {
    font-size: var(--text-lg);
  }

  a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: var(--space-1);
    transition: text-decoration-color var(--duration-fast) var(--ease-out);

    /* The whole row is the link's hit area. */
    &::after {
      content: "";
      position: absolute;
      inset: 0;
    }

    &:hover {
      text-decoration-color: currentColor;
    }

    & > span {
      color: var(--color-accent);
    }
  }

  .problem {
    max-inline-size: var(--measure);
    color: var(--color-text-muted);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin-block-start: var(--space-1);
  }

  .technology-list {
    font-size: var(--text-xs);
  }
</style>

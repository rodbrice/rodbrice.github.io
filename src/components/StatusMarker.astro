---
import type { ProjectStatus } from "../lib/projects";

interface Props {
  status: ProjectStatus;
  /** Spoken before the status, e.g. "Current status", where nothing else names it. */
  label?: string | undefined;
}

const { status, label } = Astro.props;
/**
 * A discreet shape beside the status text, which always carries the meaning:
 * full for validation with a client, half for work in development, a ring
 * for personal projects and experiments.
 */
const shape =
  status === "clientValidation"
    ? "full"
    : status === "personal" || status === "experiment"
      ? "ring"
      : "half";
---

<p class="status" data-status={status}>
  <svg viewBox="0 0 10 10" aria-hidden="true" focusable="false">
    <circle cx="5" cy="5" r="4" class:list={["outline", shape]} />
    {shape === "half" && <path d="M5 1 A4 4 0 0 1 5 9 Z" class="fill" />}
  </svg>
  {label !== undefined && <span class="visually-hidden">{`${label}: `}</span>}
  <span>
    <slot />
  </span>
</p>

<style>
  .status {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-family: var(--font-technical);
    font-size: var(--text-sm);
  }

  svg {
    flex: none;
    inline-size: 0.625rem;
    block-size: 0.625rem;
    translate: 0 0.0625rem;
  }

  .outline {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
  }

  .outline.full,
  .fill {
    fill: var(--color-accent);
  }
</style>

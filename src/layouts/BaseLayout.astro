---
import { Font } from "astro:assets";

import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import {
  DEFAULT_LOCALE,
  LOCALE_INFO,
  LOCALES,
  localizePath,
} from "../i18n/locales";
import type { Locale } from "../i18n/locales";
import { useTranslations } from "../i18n/ui";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /**
   * The page's path without its locale prefix, e.g. `/projects/`. It drives the
   * canonical URL, the hreflang alternates and the language picker. Leave it out
   * for pages with no stable URL, such as the 404 page.
   */
  path?: string;
  /** Open Graph type: `article` for case studies, `website` otherwise. */
  type?: "website" | "article";
}

const { title, description, locale, path, type = "website" } = Astro.props;
const t = useTranslations(locale);
const absolute = (pagePath: string, pageLocale: Locale) =>
  new URL(localizePath(pagePath, pageLocale), Astro.site).href;
const shareImage = new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang={LOCALE_INFO[locale].lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {path !== undefined && (
      <>
        <link rel="canonical" href={absolute(path, locale)} />
        {LOCALES.map((alternate) => (
          <link
            rel="alternate"
            hreflang={LOCALE_INFO[alternate].lang}
            href={absolute(path, alternate)}
          />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={absolute(path, DEFAULT_LOCALE)}
        />
      </>
    )}
    <title>{title}</title>
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Roduit Brice" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {path !== undefined && (
      <meta property="og:url" content={absolute(path, locale)} />
    )}
    <meta property="og:locale" content={LOCALE_INFO[locale].ogLocale} />
    {LOCALES.filter((alternate) => alternate !== locale).map((alternate) => (
      <meta
        property="og:locale:alternate"
        content={LOCALE_INFO[alternate].ogLocale}
      />
    ))}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t("meta.imageAlt")} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Apply a saved theme before the first paint to avoid a flash of the other one.
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark")
          document.documentElement.dataset.theme = theme;
      } catch {
        // Storage unavailable: follow the system theme.
      }
    </script>
    <Font cssVariable="--font-sans" preload />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t("a11y.skipLink")}
    </a>
    <SiteHeader locale={locale} path={path ?? "/"} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    inset-block-start: var(--space-2);
    inset-inline-start: var(--space-2);
    z-index: 1;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-text);
    color: var(--color-bg);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    translate: 0 -200%;

    &:focus-visible {
      translate: 0;
    }
  }

  main:focus {
    outline: none;
  }
</style>

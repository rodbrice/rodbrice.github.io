    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.1"
  }
}

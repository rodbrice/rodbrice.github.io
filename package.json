{
  "name": "rodbrice.github.io",
  "version": "0.0.0",
  "private": true,
  "description": "Personal portfolio of Roduit Brice",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:images": "node scripts/check-image-metadata.ts",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:links": "linkinator dist",
    "check:lighthouse": "lhci autorun",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test && pnpm check:images && pnpm build && pnpm check:html && pnpm check:links && pnpm test:e2e && pnpm check:lighthouse"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.0",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.13.0",
    "html-validate": "11.16.2",
    "linkinator": "8.1.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
